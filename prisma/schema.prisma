generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SECRETARY
  TREASURER
  KAGAWAD
  STAFF
}

enum Gender {
  MALE
  FEMALE
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  SEPARATED
  DIVORCED
}

enum CertificateType {
  CLEARANCE
  RESIDENCY
  INDIGENCY
  BUSINESS_PERMIT
}

enum CertificateStatus {
  PENDING
  APPROVED
  RELEASED
  DENIED
}

enum BlotterStatus {
  OPEN
  RESOLVED
  ESCALATED
}

enum AnnouncementPriority {
  URGENT
  IMPORTANT
  GENERAL
}

enum AnnouncementCategory {
  HEALTH
  SAFETY
  EVENT
  MEETING
  GENERAL
  OTHERS
}

enum PermitStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ResidentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IDStatus {
  ACTIVE
  EXPIRED
  REVOKED
  LOST
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  official            Official?
  issuedCertificates  CertificateRequest[] @relation("IssuedBy")
  handledBlotters     BlotterReport[]      @relation("HandledBy")
  postedAnnouncements Announcement[]       @relation("PostedBy")
  issuedBarangayIds   BarangayID[]         @relation("IssuedById")
  auditLogs           AuditLog[]
  notifications       Notification[]
}

model Household {
  id              String   @id @default(cuid())
  householdNumber String   @unique
  address         String
  purok           String
  zone            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  residents Resident[]

  @@index([purok])
  @@index([householdNumber])
}

model Resident {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  middleName        String?
  birthDate         DateTime
  gender            Gender
  civilStatus       CivilStatus
  householdId       String
  occupation        String?
  contactNumber     String?
  photoUrl          String?
  emergencyContact  String?
  emergencyPhone    String?
  isRegisteredVoter Boolean          @default(false)
  status            ResidentStatus   @default(APPROVED)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime @updatedAt

  household          Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  certificateRequests CertificateRequest[]
  businessPermits    BusinessPermit[]
  barangayIds        BarangayID[]

  @@index([lastName])
  @@index([firstName])
  @@index([status])
  @@index([householdId])
  @@index([contactNumber])
}

model Official {
  id        String   @id @default(cuid())
  userId    String   @unique
  position  String
  termStart DateTime
  termEnd   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CertificateRequest {
  id           String            @id @default(cuid())
  residentId   String
  type         CertificateType
  purpose      String
  status       CertificateStatus @default(PENDING)
  requestDate  DateTime          @default(now())
  releaseDate  DateTime?
  issuedById   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  issuedBy User?    @relation("IssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([residentId])
}

model BlotterReport {
  id              String        @id @default(cuid())
  caseNumber      String        @unique
  complainantName String
  respondentName  String
  incidentDate    DateTime
  incidentType    String
  location        String?
  witnesses       String?
  narrative       String
  resolutionNotes String?
  status          BlotterStatus @default(OPEN)
  handledById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  handledBy User? @relation("HandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([caseNumber])
  @@index([incidentType])
}

model BusinessPermit {
  id              String       @id @default(cuid())
  businessName    String
  ownerResidentId String
  businessType    String
  address         String
  permitNumber    String       @unique
  issueDate       DateTime
  expiryDate      DateTime
  status          PermitStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner Resident @relation(fields: [ownerResidentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiryDate])
  @@index([ownerResidentId])
  @@index([permitNumber])
}

model Announcement {
  id         String                @id @default(cuid())
  title      String
  content    String
  postedById String
  createdAt  DateTime              @default(now())
  expiresAt  DateTime?
  priority   AnnouncementPriority  @default(GENERAL)
  category   AnnouncementCategory  @default(GENERAL)
  pinned     Boolean               @default(false)
  imageUrl   String?
  viewCount  Int                   @default(0)

  postedBy User @relation("PostedBy", fields: [postedById], references: [id], onDelete: Cascade)

  @@index([priority])
  @@index([category])
  @@index([pinned])
  @@index([createdAt])
}

model BarangayID {
  id          String   @id @default(cuid())
  residentId  String
  idNumber    String   @unique
  photoUrl    String?
  issueDate   DateTime
  expiryDate  DateTime
  status      IDStatus @default(ACTIVE)
  issuedById  String?
  contactNumber String?
  address     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resident Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  issuedBy User?    @relation("IssuedById", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([residentId])
  @@index([idNumber])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
